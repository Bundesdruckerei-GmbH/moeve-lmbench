# Judge LLM (used by ragas metrics, values metric, etc.)
# Set the key matching the api_key name in config.yaml's judge_llm section
OPENAI_API_KEY=<your-openai-api-key>

# Azure OpenAI (only if using azure_openai as provider or judge)
# AZURE_OPENAI_API_KEY=<your-key>

# Optional: additional model provider keys
# VLLM_API_KEY=<your-key>
