# Judge LLM (used by ragas metrics, values metric, etc.)
# Set the key matching the api_key name in config.yaml's judge_llm section
OPENAI_API_KEY=<your-openai-api-key>

# Azure OpenAI (only if using azure_openai as provider or judge)
# AZURE_OPENAI_API_KEY=<your-key>

# Optional: additional model provider keys
# VLLM_API_KEY=<your-key>

# Anthropic (only if using anthropic as provider)
# ANTHROPIC_API_KEY=<your-key>
# Set BASE_URL only when routing through a custom gateway (e.g. Azure AI Foundry).
# The SDK appends /v1/messages itself, so set the path prefix only:
#   https://<host>/anthropic        - correct
#   https://<host>/anthropic/v1/messages  - WRONG (will 404)
# ANTHROPIC_BASE_URL=https://<host>/anthropic
# ANTHROPIC_MODEL=<deployment-name>      # used by integration tests
